DEFAULT_LANGUAGE = "english"


# ==========================================================================
# Visitor profile (mutable, per-language defaults applied on language switch).
# ==========================================================================

@dataclass
class VisitorProfile:
    age_group: str = "adult"
    art_level: str = "beginner"
    explanation_level: str = "normal"
    accessibility: list[str] = field(default_factory=list)
    interests: list[str] = field(default_factory=list)
    style: str = "warm"

    def apply_default(self, defaults: dict) -> None:
        """Reset to per-language default values."""
        self.age_group = defaults["age_group"]
        self.art_level = defaults["art_level"]
        self.explanation_level = defaults["explanation_level"]
        self.accessibility = list(defaults["accessibility"])
        self.interests = list(defaults["interests"])
        self.style = defaults["style"]

    def update_field(self, field_name: str, value: str) -> bool:
        """Apply a voice-detected profile update. Returns True if the
        profile actually changed (used to decide whether to ack)."""
        if field_name == "accessibility":
            if value not in self.accessibility:
                self.accessibility.append(value)
                return True
            return False
        if field_name in ("age_group", "art_level", "explanation_level", "style"):
            old = getattr(self, field_name)
            if old != value:
                setattr(self, field_name, value)
                return True
            return False
        return False

    def format_for_prompt(self, template: str) -> str:
        return template.format(
            age_group=self.age_group,
            art_level=self.art_level,
            explanation_level=self.explanation_level,
            accessibility=", ".join(self.accessibility) if self.accessibility else "none",
            interests=", ".join(self.interests) if self.interests else "none specified",
            style=self.style,
        )


